# --- GenPulse Environment Specifics (.env) ---
# Use GENPULSE_ prefix to override settings in Dynaconf.
# Maps to: GENPULSE_PATH__TO__VAR

# 1. Environment Mode (Dictates which section in config.yaml is loaded)
# Options: development, testing, production
ENV_FOR_DYNACONF=development

# 2. Connection Strings
# 2. Connection Strings
GENPULSE_REDIS__URL=redis://localhost:6379/0

# For local development (SQLite - no PostgreSQL required):
GENPULSE_DATABASE_URL=sqlite+aiosqlite:///data/genpulse.db

# For production (PostgreSQL):
# GENPULSE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/genpulse

# 3. Message Queue (Celery)
# GENPULSE_MQ__CELERY_BROKER_URL=redis://localhost:6379/1
# GENPULSE_MQ__CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 4. Sensitive API Credentials

# --- VolcEngine ---
GENPULSE_VOLC_ACCESS_KEY=your_volc_access_key
GENPULSE_VOLC_SECRET_KEY=your_volc_secret_key
ARK_API_KEY=your_ark_api_key

# --- Tencent Cloud ---
TENCENTCLOUD_SECRET_ID=your_tencent_secret_id
TENCENTCLOUD_SECRET_KEY=your_tencent_secret_key
TENCENTCLOUD_SUBAPP_ID=your_sub_app_id
# TENCENTCLOUD_REGION=ap-guangzhou

# --- MiniMax ---
MINIMAX_API_KEY=your_minimax_api_key

# --- Baidu Cloud (Qianfan/VOD) ---
BAIDU_AK=your_baidu_access_key
BAIDU_SK=your_baidu_secret_key

# --- DashScope (Aliyun) ---
DASHSCOPE_API_KEY=your_dashscope_api_key

# --- Kling AI ---
KLING_AK=your_kling_access_key
KLING_SK=your_kling_secret_key

# 5. Storage Overrides
# GENPULSE_STORAGE__TYPE=s3
# GENPULSE_STORAGE__S3_ENDPOINT_URL=https://s3.amazonaws.com
# GENPULSE_STORAGE__S3_ACCESS_KEY=your_access_key
# GENPULSE_STORAGE__S3_SECRET_KEY=your_secret_key
# GENPULSE_STORAGE__S3_BUCKET_NAME=genpulse

# 6. Engine address Overrides
# GENPULSE_PROVIDERS__COMFY_URL=http://127.0.0.1:8188
